#!/usr/bin/env bash
# The pay page's own address, as root: sudo radiusone-pay-domain pay.example.com
# Point the name at this server first. It gets a Let's Encrypt certificate and adds an nginx site for the name. Behind a
# tunnel or proxy that handles HTTPS, no certificate is needed: send the name to the portal and skip this.
set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[[ $EUID -eq 0 ]] || { echo 'Run as root.' >&2; exit 2; }
host=${1:-}
[[ $host =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$ ]] || { echo 'Usage: radiusone-pay-domain pay.example.com' >&2; exit 2; }
main=/etc/nginx/sites-available/radiusone
[[ -f $main ]] || { echo "Not found: $main" >&2; exit 1; }
root=$(awk '$1 == "root" { gsub(";", "", $2); print $2; exit }' "$main")
[[ -n $root ]] || { echo "No web root in $main" >&2; exit 1; }
command -v certbot >/dev/null || apt-get install -y -q --no-install-recommends certbot
certbot certonly --webroot -w "$root" -d "$host" --agree-tos -n --register-unsafely-without-email --deploy-hook 'systemctl reload nginx'
site=/etc/nginx/sites-available/radiusone-pay
# The portal's own HTTPS server block, for this name and with its certificate. The portal's app decides what this name may reach.
awk '/listen 443/ && !found { found = 1 } { lines[NR] = $0 } END { start = 0; for (i = 1; i <= NR; i++) if (lines[i] ~ /listen 443/) { start = i; break } for (i = start; i > 0; i--) if (lines[i] ~ /^server \{/) { start = i; break } for (i = start; i <= NR; i++) print lines[i] }' "$main" \
  | sed -E -e 's/ default_server//' -e "s/^( *server_name ).*/\1$host;/" \
           -e "s#^( *ssl_certificate ).*#\1/etc/letsencrypt/live/$host/fullchain.pem;#" -e "s#^( *ssl_certificate_key ).*#\1/etc/letsencrypt/live/$host/privkey.pem;#" > "$site.new"
mv "$site.new" "$site"
ln -sfn "$site" /etc/nginx/sites-enabled/radiusone-pay
if ! nginx -t; then rm -f /etc/nginx/sites-enabled/radiusone-pay "$site"; echo 'nginx refused the site; nothing changed.' >&2; exit 1; fi
systemctl reload nginx
echo "https://$host now reaches this server. Turn the page on under Settings -> Pay page."
